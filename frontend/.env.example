# Firebase project config — Firebase Console -> Project settings -> General ->
# "Your apps" -> Web app (</>) -> copy the firebaseConfig values here. Only Firestore,
# Authentication, and Hosting are used (no Storage, no Cloud Functions — both require the
# paid Blaze plan; see ARCHITECTURE.md's migration note).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to run against `firebase emulators:start` locally instead of your real
# Firebase project. Leave unset/false to talk to the real project.
VITE_USE_FIREBASE_EMULATORS=false

# Cloudinary — image uploads (product photos, logo, cover image). Free, no card required.
# Get these from cloudinary.com after creating a free account and an UNSIGNED upload
# preset (Settings -> Upload -> Upload presets -> Add upload preset -> Signing mode:
# Unsigned). Both values are public by design — see frontend/src/cloudinary/upload.ts.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
