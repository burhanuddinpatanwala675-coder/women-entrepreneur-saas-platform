# --- Backend ---
DATABASE_URL=postgresql+psycopg2://hercommerce:hercommerce_dev_pw@localhost:5432/hercommerce
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8000/uploads
CORS_ORIGINS=http://localhost:5173

# AI Assistant — leave blank to run with AI features showing "not configured"
AI_PROVIDER=none          # none | openai | anthropic
AI_API_KEY=

# Storage — MVP uses local disk. Set to "s3" + fill in creds to switch later.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
